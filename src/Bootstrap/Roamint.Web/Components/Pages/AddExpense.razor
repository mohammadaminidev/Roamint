@page "/add"
@using System.Globalization
@using Roamint.Expenses.Contracts
@using Roamint.SharedKernel
@implements IDisposable
@inject IExpensesApi Api
@inject IExpensesQueries Queries
@inject TimeProvider Clock

<PageTitle>Add expense · Roamint</PageTitle>

<div class="phone">
    <header>
        <div class="brand">
            <span class="dot"></span> Roamint
            <small>Yerevan</small>
        </div>
    </header>

    <div class="card">
        <h2>New expense</h2>

        <div class="amount-row">
            <input class="amount-input" type="text" value="@TotalDisplay" readonly />
            <div class="seg">
                @foreach (var currency in Currencies)
                {
                    <button type="button" class="@(currency.Code == currencyCode ? "active" : null)"
                            @onclick="() => SelectCurrency(currency.Code)">@currency.Code</button>
                }
            </div>
        </div>
        <p class="hint amount-hint">Total of @lines.Count item@(lines.Count == 1 ? "" : "s")</p>

        <div class="divider"></div>

        <div class="field">
            <div class="line-head">
                <label>Items</label>
                <button type="button" class="add-line" @onclick="AddLine">+ Add item</button>
            </div>

            @if (categories is null)
            {
                <p class="hint">Loading…</p>
            }
            else if (categories.Count == 0)
            {
                <p class="hint">No categories yet — add one in category management.</p>
            }
            else
            {
                @for (var index = 0; index < lines.Count; index++)
                {
                    var i = index;
                    var line = lines[i];
                    var key = $"line-{i}";
                    <div class="line-card">
                        <div class="line-top">
                            <input type="text" placeholder="Item" value="@line.Description"
                                   @oninput="e => OnLineDescInput(i, e)"
                                   @onfocus="() => activeSuggestKey = key"
                                   @onblur="() => OnLineBlur(i)" />
                            @if (lines.Count > 1)
                            {
                                <button type="button" class="line-remove" @onclick="() => RemoveLine(i)"
                                        aria-label="Remove item">×</button>
                            }
                            @if (activeSuggestKey == key && suggestions.Count > 0)
                            {
                                <div class="suggest">
                                    @foreach (var suggestion in suggestions)
                                    {
                                        <button type="button" class="suggest-item"
                                                @onclick="() => PickSuggestion(i, suggestion)">@suggestion.Text</button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="line-cat">
                            <button type="button" class="cat-current" @onclick="() => ToggleCatPicker(i)">
                                <span class="ic">@Icon(CategoryName(line.CategoryId))</span>
                                @(CategoryName(line.CategoryId) ?? "Pick category")
                                <span class="caret">⌄</span>
                            </button>
                            @if (expandedCatLine == i)
                            {
                                <div class="chips">
                                    @foreach (var category in categories)
                                    {
                                        <button type="button"
                                                class="chip @(category.Id == line.CategoryId ? "active" : null)"
                                                @onclick="() => PickCategory(i, category.Id)">
                                            <span class="ic">@Icon(category.Name)</span> @category.Name
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="line-amounts">
                            <input class="line-amount" type="text" inputmode="decimal" placeholder="Amount"
                                   value="@line.AmountText" @oninput="e => OnLineAmountInput(i, e)" />
                            <input class="line-qty" type="text" inputmode="decimal" placeholder="Qty"
                                   value="@line.QuantityText" @oninput="e => OnLineQtyInput(i, e)" />
                            <select class="line-unit" value="@(line.Unit ?? "")" @onchange="e => OnLineUnitChange(i, e)">
                                <option value="">unit</option>
                                @foreach (var unit in Units)
                                {
                                    <option value="@unit">@unit</option>
                                }
                            </select>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="field">
            <label>Date</label>
            <input type="date" @bind="date" max="@today.ToString("yyyy-MM-dd")" />
        </div>

        <div class="field">
            <label>Note (optional)</label>
            <input type="text" placeholder="Lunch near the office" value="@noteText" @oninput="OnNoteInput" />
        </div>

        @if (error is not null)
        {
            <p class="error">@error</p>
        }
        @if (success is not null)
        {
            <p class="success">@success</p>
        }
    </div>

    <button class="submit" type="button" disabled="@submitting" @onclick="Submit">
        @(submitting ? "Saving…" : "Add expense")
    </button>
</div>

@code {
    private const int MinPrefix = 2;
    private const int SuggestLimit = 6;

    private sealed record CurrencyOption(string Code, int Decimals);

    private sealed class LineRow
    {
        public string Description { get; set; } = string.Empty;
        public Guid? CategoryId { get; set; }
        public bool UserPickedCategory { get; set; }
        public string AmountText { get; set; } = string.Empty;
        public string QuantityText { get; set; } = string.Empty;
        public string? Unit { get; set; }
    }

    // The transactable currencies the form offers. IRR is display-only (toman view, later) and not here.
    private static readonly CurrencyOption[] Currencies =
    [
        new("USD", 2),
        new("AMD", 0),
        new("USDT", 2),
    ];

    // The canonical quantity-unit codes (see QuantityUnit in the domain).
    private static readonly string[] Units = ["g", "ml", "Pcs"];

    private static readonly Dictionary<string, string> Icons = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Food"] = "🍽️",
        ["Transport"] = "🚕",
        ["Rent"] = "🏠",
        ["Groceries"] = "🛒",
        ["Utilities"] = "⚡",
    };

    private IReadOnlyList<CategoryListItem>? categories;
    private string currencyCode = "AMD";
    private DateOnly date;
    private DateOnly today;
    private string noteText = string.Empty;
    private readonly List<LineRow> lines = [];
    private int? expandedCatLine;
    private bool submitting;
    private string? error;
    private string? success;

    private string? activeSuggestKey;
    private IReadOnlyList<ItemSuggestion> suggestions = [];
    private CancellationTokenSource? suggestCts;

    private int Decimals => Currencies.First(currency => currency.Code == currencyCode).Decimals;

    private string TotalDisplay => DerivedTotal().ToString($"F{Decimals}", CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        today = DateOnly.FromDateTime(Clock.GetUtcNow().UtcDateTime);
        date = today;
        categories = await Queries.ListActiveCategoriesAsync();
        lines.Add(NewLine());
    }

    private LineRow NewLine() => new() { CategoryId = categories is { Count: > 0 } ? categories[0].Id : null };

    private void SelectCurrency(string code)
    {
        currencyCode = code;
        error = null;
    }

    // ---- Categories (per line) ----

    private void ToggleCatPicker(int index) => expandedCatLine = expandedCatLine == index ? null : index;

    private void PickCategory(int index, Guid id)
    {
        lines[index].CategoryId = id;
        lines[index].UserPickedCategory = true; // a manual tap is sticky — suggestions stop moving this line's chip.
        expandedCatLine = null;
    }

    private string? CategoryName(Guid? id) =>
        id is Guid value ? categories?.FirstOrDefault(category => category.Id == value)?.Name : null;

    private static string Icon(string? name) => name is not null && Icons.TryGetValue(name, out var icon) ? icon : "🏷️";

    // ---- Lines ----

    private void AddLine()
    {
        lines.Add(NewLine());
        error = null;
    }

    private void RemoveLine(int index)
    {
        lines.RemoveAt(index);
        if (expandedCatLine == index)
        {
            expandedCatLine = null;
        }

        if (activeSuggestKey is not null)
        {
            ClearSuggestions();
        }
    }

    private void OnLineAmountInput(int index, ChangeEventArgs e)
    {
        lines[index].AmountText = e.Value?.ToString() ?? string.Empty;
        error = null;
    }

    private void OnLineQtyInput(int index, ChangeEventArgs e) =>
        lines[index].QuantityText = e.Value?.ToString() ?? string.Empty;

    private void OnLineUnitChange(int index, ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        lines[index].Unit = string.IsNullOrEmpty(value) ? null : value;
    }

    private void OnLineDescInput(int index, ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? string.Empty;
        lines[index].Description = text;
        QueueSuggest($"line-{index}", text);
    }

    private async Task OnLineBlur(int index) => await SuggestCategoryFor(index, lines[index].Description);

    // Total is the plain sum of paid line amounts, each rounded to the currency's minor units — the same
    // arithmetic the aggregate re-derives, so the read-only total can never diverge from what is stored.
    private decimal DerivedTotal()
    {
        var decimals = Decimals;
        var sum = 0m;
        foreach (var line in lines)
        {
            if (TryParseDecimal(line.AmountText, out var amount))
            {
                sum += Math.Round(amount, decimals, MidpointRounding.AwayFromZero);
            }
        }

        return sum;
    }

    // ---- Note ----

    private void OnNoteInput(ChangeEventArgs e) => noteText = e.Value?.ToString() ?? string.Empty;

    // ---- Autocomplete + category suggestion ----

    private void QueueSuggest(string key, string text)
    {
        activeSuggestKey = key;
        suggestCts?.Cancel();
        var cts = suggestCts = new CancellationTokenSource();
        var prefix = text.Trim();
        if (prefix.Length < MinPrefix)
        {
            suggestions = [];
            return;
        }

        _ = SuggestAsync(key, prefix, cts.Token);
    }

    private async Task SuggestAsync(string key, string prefix, CancellationToken ct)
    {
        try
        {
            await Task.Delay(250, ct); // debounce: one server round trip per pause, not per keystroke.
            var result = await Queries.SuggestItemsAsync(prefix, SuggestLimit, ct);
            if (ct.IsCancellationRequested)
            {
                return;
            }

            suggestions = result;
            activeSuggestKey = key;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer keystroke — drop silently.
        }
    }

    // Picking a suggestion fills the line's text, lights its category, and pre-selects its unit in one go.
    private void PickSuggestion(int index, ItemSuggestion suggestion)
    {
        var line = lines[index];
        line.Description = suggestion.Text;
        ApplySuggestedCategory(line, suggestion.CategoryId);
        if (suggestion.Unit is not null && Units.Contains(suggestion.Unit))
        {
            line.Unit = suggestion.Unit;
        }

        ClearSuggestions();
    }

    private async Task SuggestCategoryFor(int index, string text)
    {
        var line = lines[index];
        if (line.UserPickedCategory)
        {
            return;
        }

        var item = text.Trim();
        if (item.Length < MinPrefix)
        {
            return;
        }

        var categoryId = await Queries.SuggestCategoryAsync(item);
        ApplySuggestedCategory(line, categoryId);
    }

    private void ApplySuggestedCategory(LineRow line, Guid? categoryId)
    {
        if (line.UserPickedCategory || categoryId is not Guid id || categories is null)
        {
            return;
        }

        if (categories.Any(category => category.Id == id))
        {
            line.CategoryId = id;
        }
    }

    private void ClearSuggestions()
    {
        suggestions = [];
        activeSuggestKey = null;
        suggestCts?.Cancel();
    }

    // ---- Submit ----

    private async Task Submit()
    {
        error = null;
        success = null;

        if (categories is null || categories.Count == 0)
        {
            error = "No categories available.";
            return;
        }

        if (!TryBuildLines(out var dtos, out var lineError))
        {
            error = lineError;
            return;
        }

        if (date > today)
        {
            error = "The date can't be in the future.";
            return;
        }

        submitting = true;
        try
        {
            var note = string.IsNullOrWhiteSpace(noteText) ? null : noteText.Trim();
            await Api.RecordExpenseAsync(new RecordExpenseRequest(currencyCode, date, dtos, note));

            success = $"Recorded {TotalDisplay} {currencyCode}.";
            noteText = string.Empty;
            lines.Clear();
            lines.Add(NewLine());
            expandedCatLine = null;
        }
        catch (DomainException ex)
        {
            // Backstop for races the client checks can't catch (e.g. category archived between load and submit).
            error = ex.Message;
        }
        finally
        {
            submitting = false;
        }
    }

    private bool TryBuildLines(out List<ExpenseLineDto> dtos, out string? lineError)
    {
        dtos = [];
        lineError = null;
        foreach (var line in lines)
        {
            var description = line.Description.Trim();
            if (string.IsNullOrEmpty(description))
            {
                lineError = "Every item needs a name.";
                return false;
            }

            if (line.CategoryId is not Guid categoryId)
            {
                lineError = $"Pick a category for “{description}”.";
                return false;
            }

            if (!TryParseDecimal(line.AmountText, out var amount) || amount <= 0m)
            {
                lineError = $"“{description}” needs an amount greater than zero.";
                return false;
            }

            decimal? quantityValue = null;
            string? quantityUnit = null;
            var hasQty = !string.IsNullOrWhiteSpace(line.QuantityText);
            if (hasQty)
            {
                if (!TryParseDecimal(line.QuantityText, out var qty) || qty <= 0m)
                {
                    lineError = $"“{description}” has an invalid quantity.";
                    return false;
                }

                if (line.Unit is null)
                {
                    lineError = $"Pick a unit for “{description}”.";
                    return false;
                }

                quantityValue = qty;
                quantityUnit = line.Unit;
            }

            dtos.Add(new ExpenseLineDto(description, categoryId, amount, quantityValue, quantityUnit));
        }

        return dtos.Count > 0;
    }

    private static bool TryParseDecimal(string? text, out decimal value) =>
        decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out value);

    public void Dispose() => suggestCts?.Cancel();
}
