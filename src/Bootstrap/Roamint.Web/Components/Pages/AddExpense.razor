@page "/add"
@using System.Diagnostics.CodeAnalysis
@using System.Globalization
@using Roamint.Expenses.Contracts
@using Roamint.Receipts.Contracts
@using Roamint.SharedKernel
@using Roamint.Web.Capture
@implements IDisposable
@inject IExpensesApi Api
@inject IExpensesQueries Queries
@inject IReceiptsApi ReceiptsApi
@inject IImportsApi ImportsApi
@inject CaptureHandoff Handoff
@inject TimeProvider Clock

<PageTitle>Add expense · Roamint</PageTitle>

<div class="phone">
    <header>
        <div class="brand">
            <span class="dot"></span> Roamint
            <small>Yerevan</small>
        </div>
    </header>

    <div class="card">
        <h2>New expense</h2>

        @if (linkTarget is not null)
        {
            <p class="hint">@ReviewHint — check the items and pick a category for each.</p>
        }

        <div class="amount-row">
            <input class="amount-input" type="text" value="@TotalDisplay" readonly />
            <div class="seg">
                @foreach (var currency in Currencies)
                {
                    <button type="button" class="@(currency.Code == currencyCode ? "active" : null)"
                            @onclick="() => SelectCurrency(currency.Code)">@currency.Code</button>
                }
            </div>
        </div>
        <p class="hint amount-hint">Total of @lines.Count item@(lines.Count == 1 ? "" : "s")</p>

        <div class="divider"></div>

        <div class="field">
            <div class="line-head">
                <label>Items</label>
                <button type="button" class="add-line" @onclick="AddLine">+ Add item</button>
            </div>

            @if (categories is null)
            {
                <p class="hint">Loading…</p>
            }
            else if (categories.Count == 0)
            {
                <p class="hint">No categories yet — add one in category management.</p>
            }
            else
            {
                @for (var index = 0; index < lines.Count; index++)
                {
                    var i = index;
                    var line = lines[i];
                    var key = $"line-{i}";
                    <div class="line-card">
                        <div class="line-top">
                            <input type="text" placeholder="Item" value="@line.Description"
                                   @oninput="e => OnLineDescInput(i, e)"
                                   @onfocus="() => activeSuggestKey = key"
                                   @onblur="() => OnLineBlur(i)" />
                            @if (lines.Count > 1)
                            {
                                <button type="button" class="line-remove" @onclick="() => RemoveLine(i)"
                                        aria-label="Remove item">×</button>
                            }
                            @if (activeSuggestKey == key && suggestions.Count > 0)
                            {
                                <div class="suggest">
                                    @foreach (var suggestion in suggestions)
                                    {
                                        <button type="button" class="suggest-item"
                                                @onclick="() => PickSuggestion(i, suggestion)">@suggestion.Text</button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="line-cat">
                            <button type="button" class="cat-current" @onclick="() => ToggleCatPicker(i)">
                                <span class="ic">@Icon(CategoryName(line.CategoryId))</span>
                                @(CategoryName(line.CategoryId) ?? "Pick category")
                                <span class="caret">⌄</span>
                            </button>
                            @if (expandedCatLine == i)
                            {
                                <div class="chips">
                                    @foreach (var category in categories)
                                    {
                                        <button type="button"
                                                class="chip @(category.Id == line.CategoryId ? "active" : null)"
                                                @onclick="() => PickCategory(i, category.Id)">
                                            <span class="ic">@Icon(category.Name)</span> @category.Name
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="line-tags">
                            @foreach (var tagId in line.TagIds)
                            {
                                var picked = TagById(tagId);
                                <button type="button" class="tag-chip" @onclick="() => ToggleTag(i, tagId)">
                                    @(picked?.Name ?? "tag") <span class="x">×</span>
                                </button>
                            }
                            <button type="button" class="tag-add" @onclick="() => ToggleTagPicker(i)">+ Tag</button>
                            @if (expandedTagLine == i)
                            {
                                <div class="tag-pop">
                                    @foreach (var option in CompatibleTags(line.CategoryId).Where(t => !line.TagIds.Contains(t.Id)))
                                    {
                                        <button type="button" class="tag-opt" @onclick="() => ToggleTag(i, option.Id)">
                                            @option.Name@(option.Scope is null ? " ·" : "")
                                        </button>
                                    }
                                    <div class="tag-create">
                                        <input type="text" placeholder="New tag" value="@newTagText"
                                               @oninput="e => newTagText = e.Value?.ToString() ?? string.Empty" />
                                        <label class="tag-global">
                                            <input type="checkbox" checked="@newTagGlobal"
                                                   @onchange="e => newTagGlobal = (bool)(e.Value ?? false)" /> Global
                                        </label>
                                        <button type="button" class="tag-make" @onclick="() => CreateInlineTag(i)">Add</button>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="line-amounts">
                            <input class="line-amount" type="text" inputmode="decimal" placeholder="Amount"
                                   value="@line.AmountText" @oninput="e => OnLineAmountInput(i, e)" />
                            <input class="line-qty" type="text" inputmode="decimal" placeholder="Qty"
                                   value="@line.QuantityText" @oninput="e => OnLineQtyInput(i, e)" />
                            <select class="line-unit" value="@(line.Unit ?? "")" @onchange="e => OnLineUnitChange(i, e)">
                                <option value="">unit</option>
                                @foreach (var unit in Units)
                                {
                                    <option value="@unit">@unit</option>
                                }
                            </select>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="field">
            <label>Date</label>
            <input type="date" @bind="date" @bind:after="ResetDuplicateGuard" max="@today.ToString("yyyy-MM-dd")" />
        </div>

        <div class="field">
            <label>Note (optional)</label>
            <input type="text" placeholder="Lunch near the office" value="@noteText" @oninput="OnNoteInput" />
        </div>

        @if (error is not null)
        {
            <p class="error">@error</p>
        }
        @if (success is not null)
        {
            <p class="success">@success</p>
        }
        @if (duplicateMatches > 0)
        {
            <div class="confirm">
                <p>You already logged @TotalDisplay @currencyCode on this date (@duplicateMatches existing). Save anyway?</p>
                <div class="confirm-actions">
                    <button type="button" class="confirm-save" disabled="@submitting" @onclick="ConfirmDuplicate">Save anyway</button>
                    <button type="button" class="confirm-cancel" @onclick="DismissDuplicate">Review</button>
                </div>
            </div>
        }
    </div>

    <button class="submit" type="button" disabled="@submitting" @onclick="Submit">
        @(submitting ? "Saving…" : "Add expense")
    </button>

    <NavBar />
</div>

@code {
    private const int MinPrefix = 2;
    private const int SuggestLimit = 6;

    private sealed record CurrencyOption(string Code, int Decimals);

    private sealed class LineRow
    {
        public string Description { get; set; } = string.Empty;
        public Guid? CategoryId { get; set; }
        public bool UserPickedCategory { get; set; }
        public string AmountText { get; set; } = string.Empty;
        public string QuantityText { get; set; } = string.Empty;
        public string? Unit { get; set; }
        public List<Guid> TagIds { get; } = [];

        // Set for lines seeded from a receipt — the original (Armenian) text, used to learn the item mapping
        // on confirm. Null for hand-added lines.
        public string? SourceText { get; set; }
    }

    // The transactable currencies the form offers. IRT is display-only (toman view, later) and not here.
    private static readonly CurrencyOption[] Currencies =
    [
        new("USD", 2),
        new("AMD", 0),
        new("USDT", 2),
    ];

    // The canonical quantity-unit codes (see QuantityUnit in the domain).
    private static readonly string[] Units = ["g", "ml", "Pcs"];

    private static readonly Dictionary<string, string> Icons = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Food"] = "🍽️",
        ["Transport"] = "🚕",
        ["Rent"] = "🏠",
        ["Groceries"] = "🛒",
        ["Utilities"] = "⚡",
    };

    private IReadOnlyList<CategoryListItem>? categories;
    private IReadOnlyList<TagListItem> allTags = [];
    private int? expandedTagLine;
    private string newTagText = string.Empty;
    private bool newTagGlobal;
    private string currencyCode = "AMD";
    private DateOnly date;
    private DateOnly today;
    private string noteText = string.Empty;
    private readonly List<LineRow> lines = [];
    private int? expandedCatLine;
    private bool submitting;
    private string? error;
    private string? success;

    // Duplicate guard (0022): count of same-day/-currency/-total twins found on the last save attempt, and
    // whether the user has confirmed past them. duplicateMatches > 0 shows the inline confirm banner.
    private int duplicateMatches;
    private bool duplicateConfirmed;

    // Set when reviewing a handed-off capture: which source to link back to on confirm, and its id.
    private (CaptureSource Source, Guid Id)? linkTarget;

    private string ReviewHint => linkTarget?.Source == CaptureSource.ImportedOrder
        ? "Reviewing a pasted order"
        : "Reviewing a scanned receipt";

    private string? activeSuggestKey;
    private IReadOnlyList<ItemSuggestion> suggestions = [];
    private CancellationTokenSource? suggestCts;

    private int Decimals => Currencies.First(currency => currency.Code == currencyCode).Decimals;

    private string TotalDisplay => DerivedTotal().ToString($"F{Decimals}", CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        today = DateOnly.FromDateTime(Clock.GetUtcNow().UtcDateTime);
        date = today;
        categories = await Queries.ListActiveCategoriesAsync();
        allTags = await Queries.ListTagsAsync();
        lines.Add(NewLine());

        // If we arrived from a scanned receipt or a pasted order, seed the form from its draft and suggest categories.
        if (ApplyCaptureHandoff())
        {
            for (var i = 0; i < lines.Count; i++)
            {
                await SuggestCategoryFor(i, lines[i].Description);
            }
        }
    }

    // Seeds currency/date/lines from a handed-off capture. Matched lines (resolved against the learned item
    // vocabulary, 0016) arrive with their canonical description + category + unit; unmatched lines carry the
    // first-time translation and get a category suggestion below. Returns true if a capture is reviewed.
    private bool ApplyCaptureHandoff()
    {
        if (!Handoff.HasPending)
        {
            return false;
        }

        var seed = Handoff.Pending!;
        Handoff.Clear();
        linkTarget = (seed.Source, seed.SourceId);

        if (seed.CurrencyCode is { Length: > 0 } code && Currencies.Any(currency => currency.Code == code))
        {
            currencyCode = code;
        }

        if (seed.Date is DateOnly parsedDate && parsedDate <= today)
        {
            date = parsedDate;
        }

        if (seed.Lines.Count == 0)
        {
            return true;
        }

        lines.Clear();
        foreach (var seedLine in seed.Lines)
        {
            var row = NewLine();
            row.SourceText = seedLine.SourceText;
            row.Description = seedLine.Description;
            row.AmountText = seedLine.Amount > 0m
                ? seedLine.Amount.ToString(CultureInfo.InvariantCulture)
                : string.Empty;

            // A learned match is authoritative — pin its category (so the suggestion pass skips it) and unit.
            if (seedLine.CategoryId is Guid matchedCategory && categories!.Any(category => category.Id == matchedCategory))
            {
                row.CategoryId = matchedCategory;
                row.UserPickedCategory = true;
            }

            if (seedLine.Unit is { Length: > 0 } unit && Units.Contains(unit))
            {
                row.Unit = unit;
            }

            lines.Add(row);
        }

        return true;
    }

    private LineRow NewLine() => new() { CategoryId = categories is { Count: > 0 } ? categories[0].Id : null };

    // Records each receipt-sourced line's mapping (Armenian source → confirmed Farsi name + unit + category)
    // so the next receipt with that item resolves it automatically (0016). Best-effort: the expense is already
    // saved, so a learning failure (e.g. the embedder is offline) must not surface as an error.
    [SuppressMessage(
        "Design",
        "CA1031:Do not catch general exception types",
        Justification = "Learning is best-effort over an external embedder; failures are swallowed so they "
            + "never block the already-recorded expense.")]
    private async Task LearnItemMappingsAsync()
    {
        foreach (var line in lines)
        {
            var source = line.SourceText?.Trim();
            var description = line.Description.Trim();
            if (string.IsNullOrEmpty(source) || description.Length == 0 || line.CategoryId is not Guid categoryId)
            {
                continue;
            }

            try
            {
                await Api.RecordItemMappingAsync(new RecordItemMappingRequest(source, description, line.Unit, categoryId));
            }
            catch (Exception)
            {
                // Swallow — see attribute.
            }
        }
    }

    private void SelectCurrency(string code)
    {
        currencyCode = code;
        error = null;
        ResetDuplicateGuard();
    }

    // ---- Categories (per line) ----

    private void ToggleCatPicker(int index) => expandedCatLine = expandedCatLine == index ? null : index;

    private void PickCategory(int index, Guid id)
    {
        lines[index].CategoryId = id;
        lines[index].UserPickedCategory = true; // a manual tap is sticky — suggestions stop moving this line's chip.
        DropIncompatibleTags(lines[index]);
        expandedCatLine = null;
    }

    private string? CategoryName(Guid? id) =>
        id is Guid value ? categories?.FirstOrDefault(category => category.Id == value)?.Name : null;

    private static string Icon(string? name) => name is not null && Icons.TryGetValue(name, out var icon) ? icon : "🏷️";

    // ---- Tags (per line) ----

    private TagListItem? TagById(Guid id) => allTags.FirstOrDefault(tag => tag.Id == id);

    // Picker set for a line: global tags ∪ tags scoped to the line's chosen category (0009 D4).
    private IEnumerable<TagListItem> CompatibleTags(Guid? categoryId) =>
        allTags.Where(tag => tag.Scope is null || tag.Scope == categoryId);

    private void ToggleTagPicker(int index)
    {
        expandedTagLine = expandedTagLine == index ? null : index;
        newTagText = string.Empty;
        newTagGlobal = false;
    }

    private void ToggleTag(int index, Guid tagId)
    {
        var tags = lines[index].TagIds;
        if (!tags.Remove(tagId))
        {
            tags.Add(tagId);
        }
    }

    // A scoped tag whose category no longer matches the line is dropped; globals always stay (mirrors the
    // currency re-round in 0008 — the structure can't carry an incompatible classifier to submit).
    private void DropIncompatibleTags(LineRow line) =>
        line.TagIds.RemoveAll(id => TagById(id)?.Scope is Guid scope && scope != line.CategoryId);

    private async Task CreateInlineTag(int index)
    {
        var name = newTagText.Trim();
        if (name.Length == 0)
        {
            return;
        }

        var line = lines[index];
        Guid? scope = newTagGlobal ? null : line.CategoryId;
        if (!newTagGlobal && scope is null)
        {
            error = "Pick a category first to scope the tag, or mark it global.";
            return;
        }

        try
        {
            var id = await Api.CreateTagAsync(new CreateTagRequest(name, scope));
            allTags = await Queries.ListTagsAsync();
            if (!line.TagIds.Contains(id))
            {
                line.TagIds.Add(id);
            }

            newTagText = string.Empty;
            newTagGlobal = false;
        }
        catch (DomainException ex)
        {
            error = ex.Message;
        }
    }

    // ---- Lines ----

    private void AddLine()
    {
        lines.Add(NewLine());
        error = null;
        ResetDuplicateGuard();
    }

    private void RemoveLine(int index)
    {
        lines.RemoveAt(index);
        ResetDuplicateGuard();
        if (expandedCatLine == index)
        {
            expandedCatLine = null;
        }

        if (expandedTagLine == index)
        {
            expandedTagLine = null;
        }

        if (activeSuggestKey is not null)
        {
            ClearSuggestions();
        }
    }

    private void OnLineAmountInput(int index, ChangeEventArgs e)
    {
        lines[index].AmountText = e.Value?.ToString() ?? string.Empty;
        error = null;
        ResetDuplicateGuard();
    }

    private void OnLineQtyInput(int index, ChangeEventArgs e) =>
        lines[index].QuantityText = e.Value?.ToString() ?? string.Empty;

    private void OnLineUnitChange(int index, ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        lines[index].Unit = string.IsNullOrEmpty(value) ? null : value;
    }

    private void OnLineDescInput(int index, ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? string.Empty;
        lines[index].Description = text;
        QueueSuggest($"line-{index}", text);
    }

    private async Task OnLineBlur(int index)
    {
        await SuggestCategoryFor(index, lines[index].Description);

        // Drop the dropdown once focus leaves the field, so it doesn't linger when the user moves on without
        // picking. Blur fires before a suggestion's click, so wait briefly: PickSuggestion clears the active key
        // first, and if it did we skip clearing here (the pick already handled it).
        var key = $"line-{index}";
        await Task.Delay(200);
        if (activeSuggestKey == key)
        {
            ClearSuggestions();
            await InvokeAsync(StateHasChanged);
        }
    }

    // Total is the plain sum of paid line amounts, each rounded to the currency's minor units — the same
    // arithmetic the aggregate re-derives, so the read-only total can never diverge from what is stored.
    private decimal DerivedTotal()
    {
        var decimals = Decimals;
        var sum = 0m;
        foreach (var line in lines)
        {
            if (TryParseDecimal(line.AmountText, out var amount))
            {
                sum += Math.Round(amount, decimals, MidpointRounding.AwayFromZero);
            }
        }

        return sum;
    }

    // ---- Note ----

    private void OnNoteInput(ChangeEventArgs e) => noteText = e.Value?.ToString() ?? string.Empty;

    // ---- Autocomplete + category suggestion ----

    private void QueueSuggest(string key, string text)
    {
        activeSuggestKey = key;
        suggestCts?.Cancel();
        var cts = suggestCts = new CancellationTokenSource();
        var prefix = text.Trim();
        if (prefix.Length < MinPrefix)
        {
            suggestions = [];
            return;
        }

        _ = SuggestAsync(key, prefix, cts.Token);
    }

    private async Task SuggestAsync(string key, string prefix, CancellationToken ct)
    {
        try
        {
            await Task.Delay(250, ct); // debounce: one server round trip per pause, not per keystroke.
            var result = await Queries.SuggestItemsAsync(prefix, SuggestLimit, ct);
            if (ct.IsCancellationRequested)
            {
                return;
            }

            suggestions = result;
            activeSuggestKey = key;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer keystroke — drop silently.
        }
    }

    // Picking a suggestion fills the line's text, lights its category, and pre-selects its unit in one go.
    private void PickSuggestion(int index, ItemSuggestion suggestion)
    {
        var line = lines[index];
        line.Description = suggestion.Text;
        ApplySuggestedCategory(line, suggestion.CategoryId);
        if (suggestion.Unit is not null && Units.Contains(suggestion.Unit))
        {
            line.Unit = suggestion.Unit;
        }

        // Pre-select the remembered tags that are still scope-compatible with the (possibly user-pinned)
        // category; an incompatible remembered tag is silently dropped.
        foreach (var tagId in suggestion.TagIds)
        {
            var tag = TagById(tagId);
            if (tag is not null && (tag.Scope is null || tag.Scope == line.CategoryId) && !line.TagIds.Contains(tagId))
            {
                line.TagIds.Add(tagId);
            }
        }

        ClearSuggestions();
    }

    private async Task SuggestCategoryFor(int index, string text)
    {
        var line = lines[index];
        if (line.UserPickedCategory)
        {
            return;
        }

        var item = text.Trim();
        if (item.Length < MinPrefix)
        {
            return;
        }

        var categoryId = await Queries.SuggestCategoryAsync(item);
        ApplySuggestedCategory(line, categoryId);
    }

    private void ApplySuggestedCategory(LineRow line, Guid? categoryId)
    {
        if (line.UserPickedCategory || categoryId is not Guid id || categories is null)
        {
            return;
        }

        if (categories.Any(category => category.Id == id))
        {
            line.CategoryId = id;
            DropIncompatibleTags(line);
        }
    }

    private void ClearSuggestions()
    {
        suggestions = [];
        activeSuggestKey = null;
        suggestCts?.Cancel();
    }

    // ---- Submit ----

    private async Task Submit()
    {
        error = null;
        success = null;

        if (categories is null || categories.Count == 0)
        {
            error = "No categories available.";
            return;
        }

        if (!TryBuildLines(out var dtos, out var lineError))
        {
            error = lineError;
            return;
        }

        if (date > today)
        {
            error = "The date can't be in the future.";
            return;
        }

        // Duplicate guard (0022): warn once if an expense with this day + currency + total already exists.
        // A soft prompt, not a block — equal-total same-day expenses are legal. Confirming sets the flag so
        // the re-run skips straight to the save; any edit to the total/day/currency clears it (ResetDuplicateGuard).
        if (!duplicateConfirmed)
        {
            duplicateMatches = await Queries.CountSameDayMatchesAsync(date, currencyCode, DerivedTotal());
            if (duplicateMatches > 0)
            {
                return;
            }
        }

        submitting = true;
        try
        {
            var note = string.IsNullOrWhiteSpace(noteText) ? null : noteText.Trim();
            var expenseId = await Api.RecordExpenseAsync(new RecordExpenseRequest(currencyCode, date, dtos, note));

            // If this expense came from a capture, link the source to the expense (host orchestration — 0015/
            // 0017) and learn each line's mapping so the next capture resolves it automatically (0016).
            if (linkTarget is (CaptureSource source, Guid sourceId))
            {
                switch (source)
                {
                    case CaptureSource.Receipt:
                        await ReceiptsApi.LinkAsync(sourceId, expenseId);
                        break;
                    case CaptureSource.ImportedOrder:
                        await ImportsApi.LinkAsync(sourceId, expenseId);
                        break;
                }

                await LearnItemMappingsAsync();
                linkTarget = null;
            }

            success = $"Recorded {TotalDisplay} {currencyCode}.";
            noteText = string.Empty;
            lines.Clear();
            lines.Add(NewLine());
            expandedCatLine = null;
            expandedTagLine = null;
            duplicateMatches = 0;
            duplicateConfirmed = false;
        }
        catch (DomainException ex)
        {
            // Backstop for races the client checks can't catch (e.g. category archived between load and submit).
            error = ex.Message;
        }
        finally
        {
            submitting = false;
        }
    }

    // User accepted the twin — record anyway. Re-runs Submit with the confirmed flag set so the guard passes.
    private async Task ConfirmDuplicate()
    {
        duplicateConfirmed = true;
        duplicateMatches = 0;
        await Submit();
    }

    // User wants to review — drop the banner and return to editing without saving.
    private void DismissDuplicate() => duplicateMatches = 0;

    // Any change to the match key (total/day/currency) invalidates a pending confirmation, so the next save
    // re-checks rather than committing on a stale "save anyway".
    private void ResetDuplicateGuard()
    {
        duplicateMatches = 0;
        duplicateConfirmed = false;
    }

    private bool TryBuildLines(out List<ExpenseLineDto> dtos, out string? lineError)
    {
        dtos = [];
        lineError = null;
        foreach (var line in lines)
        {
            var description = line.Description.Trim();
            if (string.IsNullOrEmpty(description))
            {
                lineError = "Every item needs a name.";
                return false;
            }

            if (line.CategoryId is not Guid categoryId)
            {
                lineError = $"Pick a category for “{description}”.";
                return false;
            }

            if (!TryParseDecimal(line.AmountText, out var amount) || amount <= 0m)
            {
                lineError = $"“{description}” needs an amount greater than zero.";
                return false;
            }

            decimal? quantityValue = null;
            string? quantityUnit = null;
            var hasQty = !string.IsNullOrWhiteSpace(line.QuantityText);
            if (hasQty)
            {
                if (!TryParseDecimal(line.QuantityText, out var qty) || qty <= 0m)
                {
                    lineError = $"“{description}” has an invalid quantity.";
                    return false;
                }

                if (line.Unit is null)
                {
                    lineError = $"Pick a unit for “{description}”.";
                    return false;
                }

                quantityValue = qty;
                quantityUnit = line.Unit;
            }

            dtos.Add(new ExpenseLineDto(
                description, categoryId, amount, quantityValue, quantityUnit,
                line.TagIds.Count > 0 ? line.TagIds.ToList() : null));
        }

        return dtos.Count > 0;
    }

    private static bool TryParseDecimal(string? text, out decimal value) =>
        decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out value);

    public void Dispose() => suggestCts?.Cancel();
}
