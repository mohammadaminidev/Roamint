@page "/receipts/new"
@using System.Diagnostics.CodeAnalysis
@using Microsoft.JSInterop
@using Roamint.Receipts.Contracts
@using Roamint.Web.Processing
@implements IAsyncDisposable
@inject IReceiptsApi ReceiptsApi
@inject ReceiptJobs Jobs
@inject IJSRuntime JS

<PageTitle>Scan receipt · Roamint</PageTitle>

<div class="phone">
    <header>
        <div class="brand">
            <span class="dot"></span> Roamint
            <small>Yerevan</small>
        </div>
    </header>

    <div class="card">
        <h2>Scan a receipt</h2>
        <p class="hint">Photograph the receipt with the live camera, or choose an existing image. Reading happens
            in the background — keep snapping, and review each one from the bar below when it's ready.</p>

        @if (busy)
        {
            <div class="processing">
                <span class="spinner" aria-hidden="true"></span>
                <p class="processing-label">Saving photo…</p>
            </div>
        }

        @if (justQueued && !busy)
        {
            <p class="success">Added to the queue — review it from the bar below when it's ready.</p>
        }

        <div class="viewfinder @(cameraOpen && !busy ? null : "is-hidden")">
            <video @ref="video" playsinline muted autoplay></video>
            <div class="viewfinder-actions">
                <button type="button" class="ghost" @onclick="StopCamera">Cancel</button>
                <button type="button" class="cap" @onclick="Capture">
                    <i class="ti ti-camera ic" aria-hidden="true"></i> Capture
                </button>
            </div>
        </div>

        @if (!cameraOpen && !busy)
        {
            <button type="button" class="receipt-pick" @onclick="StartCamera">
                <i class="ti ti-camera ic" aria-hidden="true"></i>
                <span>Use camera</span>
            </button>

            <label class="receipt-pick file">
                <i class="ti ti-photo ic" aria-hidden="true"></i>
                <span>Choose photo</span>
                <InputFile OnChange="OnFile" accept="image/*" />
            </label>
        }

        @if (error is not null)
        {
            <p class="error">@error</p>
        }
    </div>

    <NavBar />
</div>

@code {
    // The browser already caps the long edge (1600px JPEG, see receipt-camera.js), so the
    // file-input backstop only needs to reject an accidentally huge original.
    private const long MaxBytes = 12L * 1024 * 1024;

    private IJSObjectReference? module;
    private ElementReference video;
    private bool cameraOpen;
    private bool busy;
    private bool justQueued;
    private string? error;

    private async Task<IJSObjectReference> ModuleAsync() =>
        module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/receipt-camera.js");

    private async Task StartCamera()
    {
        error = null;
        justQueued = false;
        cameraOpen = true; // render the <video> before wiring the stream to it.
        StateHasChanged();

        var ok = await (await ModuleAsync()).InvokeAsync<bool>("start", video);
        if (!ok)
        {
            cameraOpen = false;
            error = "Camera unavailable here — needs an HTTPS connection. Use “Choose photo” instead.";
        }
    }

    private async Task StopCamera()
    {
        if (module is not null)
        {
            await module.InvokeVoidAsync("stop");
        }
        cameraOpen = false;
    }

    [SuppressMessage(
        "Design",
        "CA1031:Do not catch general exception types",
        Justification = "Capture spans JS interop (canvas/toBlob) + the upload; any failure should surface as a "
            + "friendly on-page message rather than a silently-dropped circuit error.")]
    private async Task Capture()
    {
        byte[] bytes;
        try
        {
            bytes = await (await ModuleAsync()).InvokeAsync<byte[]>("capture", video);
        }
        catch (Exception ex)
        {
            error = $"Couldn't capture the photo: {ex.Message}";
            await StopCamera();
            return;
        }

        // Switch to the processing state and render it BEFORE tearing down the stream, so the
        // dead (black) viewfinder is never shown while the OCR call runs.
        error = null;
        justQueued = false;
        cameraOpen = false;
        busy = true;
        StateHasChanged();

        await StopCamera();
        await Submit(bytes);
    }

    [SuppressMessage(
        "Design",
        "CA1031:Do not catch general exception types",
        Justification = "Reading + downscaling a chosen file spans IO and JS interop; any failure should surface as "
            + "a friendly on-page message rather than an unhandled circuit error.")]
    private async Task OnFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        if (file.Size > MaxBytes)
        {
            error = "That image is too large.";
            return;
        }

        error = null;
        justQueued = false;

        byte[] resized;
        try
        {
            // Read the original bytes BEFORE flipping to busy: busy hides the <InputFile>, and Blazor
            // streams the file from that element, so unmounting it mid-read fails ("_blazorFilesById").
            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(MaxBytes))
            {
                await stream.CopyToAsync(buffer);
            }

            busy = true;
            StateHasChanged();

            // Downscale in the browser through the same canvas pipeline as the live camera so the
            // file path saves Gemini tokens too.
            var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
            resized = await (await ModuleAsync()).InvokeAsync<byte[]>("resizeFile", buffer.ToArray(), contentType);
        }
        catch (Exception ex)
        {
            error = $"Couldn't read that image: {ex.Message}";
            busy = false;
            return;
        }

        await Submit(resized);
    }

    [SuppressMessage(
        "Design",
        "CA1031:Do not catch general exception types",
        Justification = "Upload is a user action over IO; any failure should surface as a friendly message on "
            + "the page, not an unhandled circuit error.")]
    private async Task Submit(byte[] image)
    {
        error = null;
        busy = true;
        try
        {
            // Fast path: store the image and hand the id to the background worker (0019). OCR + matching run
            // off the circuit, surfaced in the job bar, so the user can immediately snap the next receipt.
            var id = await ReceiptsApi.UploadAsync(new UploadReceiptRequest(image, "image/jpeg"));
            await Jobs.EnqueueAsync(id);

            busy = false;
            justQueued = true;
        }
        catch (Exception ex)
        {
            error = $"Couldn't upload that photo: {ex.Message}";
            busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("stop");
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone (page closed) — nothing to clean up.
            }
        }
    }
}
