{
  "name": "roamint-inbox-relay",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply roamint-inbox --local",
    "migrate:remote": "wrangler d1 migrations apply roamint-inbox --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.6",
    "@cloudflare/workers-types": "5.20261019.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.3"
  }
}
